<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/style.css">
    <style>
        .admin-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 20px; margin-top: 20px; }
        .admin-card { background: #1e1e1e; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #2d2d2d; }
        .admin-card h4 { color: #bb86fc; margin-top: 0; margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px; font-size: 1.1rem; }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 0.85rem; color: #b3b3b3; margin-bottom: 5px; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; padding: 10px; background: #2c2c2c; border: 1px solid #444; color: #fff; border-radius: 6px; box-sizing: border-box; font-size: 0.9rem;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #bb86fc; outline: none; }
        .btn-submit { background: #bb86fc; color: #121212; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 5px; font-size: 0.95rem; }
        .btn-submit:hover { background: #a362f8; }
        .admin-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.85rem; }
        .admin-table th, .admin-table td { padding: 10px; text-align: left; border-bottom: 1px solid #333; }
        .admin-table th { background: #2c2c2c; color: #bb86fc; }
        .btn-act-chapter { background: #bb86fc; color: #121212; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.8rem; display: inline-block; margin-right: 4px; }
        .btn-act-edit { background: #03dac6; color: #000; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.8rem; display: inline-block; margin-right: 4px; }
        .btn-act-del { background: #cf6679; color: #fff; border: none; padding: 5px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; cursor: pointer; }
        .alert-msg { background: #2e7d32; color: white; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-weight: bold; text-align: center; }
        @media (max-width: 900px) {
            .admin-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <%- include('components/header') %>

    <div class="container">
        <h3 class="section-title">⚙️ Dashboard Admin TachiWeb</h3>

        <% if(pesan === 'tambah_sukses') { %>
            <div class="alert-msg">✓ Komik baru berhasil ditambahkan!</div>
        <% } else if(pesan === 'edit_sukses') { %>
            <div class="alert-msg">✓ Data komik berhasil diperbarui!</div>
        <% } else if(pesan === 'hapus_sukses') { %>
            <div class="alert-msg" style="background: #c62828;">🗑️ Komik berhasil dihapus!</div>
        <% } else if(pesan === 'hapus_user_sukses') { %>
            <div class="alert-msg" style="background: #c62828;">🗑️ Pengguna berhasil dihapus!</div>
        <% } else if(pesan === 'reset_password_sukses') { %>
            <div class="alert-msg">✓ Password pengguna berhasil direset menjadi 'user123'!</div>
        <% } else if(pesan === 'ubah_role_sukses') { %>
            <div class="alert-msg">✓ Hak akses/Role pengguna berhasil diperbarui!</div>
        <% } else if(pesan === 'hapus_feedback_sukses') { %>
            <div class="alert-msg" style="background: #c62828;">🗑️ Feedback berhasil dihapus!</div>
        <% } %>

        <div class="admin-grid">
            <!-- KOLOM KIRI: FORM TAMBAH KOMIK -->
            <div>
                <div class="admin-card">
                    <h4>+ Tambah Komik Baru</h4>
                    <form action="/admin/komik/tambah" method="POST" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Judul Komik</label>
                            <input type="text" name="judul" placeholder="contoh: Solo Leveling" required>
                        </div>
                        <div class="form-group">
                            <label>Author / Pembuat</label>
                            <input type="text" name="author" placeholder="contoh: Chugong" required>
                        </div>
                        <div class="form-group">
                            <label>Sumber / Scanner</label>
                            <input type="text" name="sumber" placeholder="contoh: Asura, SUKI, MangaPlus" required>
                        </div>
                        <div class="form-group">
                            <label>Tipe Komik</label>
                            <select name="tipe">
                                <option value="Manga">🇯🇵 Manga (Jepang)</option>
                                <option value="Manhwa" selected>🇰🇷 Manhwa (Korea)</option>
                                <option value="Manhua">🇨🇳 Manhua (China)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Status</label>
                            <select name="status">
                                <option value="Ongoing" selected>Ongoing</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Genre (pisahkan dengan koma)</label>
                            <input type="text" name="genre" placeholder="Action, Fantasy, Adventure">
                        </div>
                        <div class="form-group">
                            <label>Unggah Gambar Cover (File)</label>
                            <input type="file" name="cover" accept="image/*">
                        </div>
                        <div class="form-group">
                            <label>Atau URL Cover Gambar</label>
                            <input type="url" name="cover_url" placeholder="https://...">
                        </div>
                        <div class="form-group">
                            <label>Sinopsis</label>
                            <textarea name="sinopsis" rows="4" placeholder="Tuliskan ringkasan cerita komik..." required></textarea>
                        </div>
                        <button type="submit" class="btn-submit">+ Tambah Komik</button>
                    </form>
                </div>
            </div>

            <!-- KOLOM KANAN: DAFTAR KOMIK, USER & FEEDBACK -->
            <div>
                <!-- DAFTAR KOMIK -->
                <div class="admin-card">
                    <h4>📚 Daftar Komik (<%= comics.length %>)</h4>
                    <div style="overflow-x: auto;">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Cover</th>
                                    <th>Judul</th>
                                    <th>Tipe & Sumber</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% comics.forEach(function(k) { %>
                                    <tr>
                                        <td>
                                            <img src="<%= k.cover %>" alt="Cover" style="width: 40px; height: 55px; object-fit: cover; border-radius: 4px;" onerror="this.onerror=null;this.src='https://placehold.co/40x55/2c2c2c/bb86fc?text=C';">
                                        </td>
                                        <td>
                                            <strong><%= k.judul %></strong><br>
                                            <span style="color: #888; font-size: 0.75rem;"><%= k.author %></span>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.8rem;"><%= k.tipe || 'Manga' %></span><br>
                                            <span style="color: #bb86fc; font-size: 0.75rem;"><%= k.sumber %></span>
                                        </td>
                                        <td>
                                            <span style="color: <%= k.status === 'Completed' ? '#03dac6' : '#ffb74d' %>; font-size: 0.8rem;"><%= k.status %></span>
                                        </td>
                                        <td>
                                            <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                                                <a href="/admin/kelola-chapter/<%= k.id_komik %>" class="btn-act-chapter">Chapter</a>
                                                <a href="/admin/komik/edit/<%= k.id_komik %>" class="btn-act-edit">Edit</a>
                                                <form action="/admin/komik/hapus" method="POST" onsubmit="return confirm('Apakah kamu yakin ingin menghapus komik ini? Semua chapter akan terhapus.');" style="margin: 0;">
                                                    <input type="hidden" name="id_komik" value="<%= k.id_komik %>">
                                                    <button type="submit" class="btn-act-del">Hapus</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- DAFTAR PENGGUNA -->
                <div class="admin-card">
                    <h4>👥 Daftar Pengguna Terdaftar (<%= users.length %>)</h4>
                    <div style="overflow-x: auto;">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Username</th>
                                    <th>Nama Panggilan</th>
                                    <th>Role</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(users.length === 0) { %>
                                    <tr><td colspan="5" style="text-align: center; color: #888;">Belum ada pengguna terdaftar lain.</td></tr>
                                <% } else { %>
                                    <% users.forEach(function(u) { %>
                                        <tr>
                                            <td>#<%= u.id_user %></td>
                                            <td><strong><%= u.username %></strong></td>
                                            <td><%= u.nama_panggilan %></td>
                                            <td>
                                                <form action="/admin/user/role" method="POST" style="margin: 0; display: inline-flex; align-items: center; gap: 6px;">
                                                    <input type="hidden" name="id_user" value="<%= u.id_user %>">
                                                    <select name="role" onchange="this.form.submit()" style="padding: 4px 8px; background: #252525; color: <%= u.role === 'admin' ? '#bb86fc' : '#03dac6' %>; border: 1px solid #444; border-radius: 4px; font-size: 0.78rem; font-weight: bold; cursor: pointer;">
                                                        <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>User</option>
                                                        <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                                    </select>
                                                </form>
                                            </td>
                                            <td>
                                                <div style="display: flex; gap: 4px;">
                                                    <form action="/admin/user/reset-password" method="POST" onsubmit="return confirm('Reset password user ini ke user123?');" style="margin: 0;">
                                                        <input type="hidden" name="id_user" value="<%= u.id_user %>">
                                                        <button type="submit" class="btn-act-edit" style="background: #ffb74d; color: black; border: none; cursor: pointer;">Reset PW</button>
                                                    </form>
                                                    <form action="/admin/user/hapus" method="POST" onsubmit="return confirm('Hapus pengguna ini? Semua data library dan komentarnya akan terhapus.');" style="margin: 0;">
                                                        <input type="hidden" name="id_user" value="<%= u.id_user %>">
                                                        <button type="submit" class="btn-act-del">Hapus</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- DAFTAR FEEDBACK -->
                <div class="admin-card">
                    <h4>💬 Masukan & Feedback Pengguna (<%= feedbackList.length %>)</h4>
                    <% if(feedbackList.length === 0) { %>
                        <div style="color: #888; padding: 15px 0;">Belum ada feedback yang masuk dari pengguna.</div>
                    <% } else { %>
                        <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 10px;">
                            <% feedbackList.forEach(function(fb) { %>
                                <div style="background: #2c2c2c; padding: 14px; border-radius: 6px; border: 1px solid #383838;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                        <div>
                                            <strong style="color: #bb86fc;"><%= fb.nama_panggilan %></strong>
                                            <span style="color: #888; font-size: 0.8rem;">(@<%= fb.username %> &bull; <%= fb.tanggal %>)</span>
                                        </div>
                                        <form action="/admin/feedback/hapus" method="POST" onsubmit="return confirm('Hapus feedback ini?');" style="margin: 0;">
                                            <input type="hidden" name="id_feedback" value="<%= fb.id_feedback %>">
                                            <button type="submit" class="btn-act-del">Hapus</button>
                                        </form>
                                    </div>
                                    <p style="color: #e0e0e0; font-size: 0.9rem; margin: 0; line-height: 1.5; white-space: pre-wrap;"><%= fb.isi_feedback %></p>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <%- include('components/footer') %>

</body>
</html>
