<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/style.css">
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #121212; 
            color: white; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0; 
            padding: 20px;
            box-sizing: border-box;
        }
        .login-box { 
            background-color: #1e1e1e; 
            padding: 35px 25px; 
            border-radius: 12px; 
            width: 100%; 
            max-width: 420px; 
            box-shadow: 0 8px 30px rgba(0,0,0,0.7); 
            box-sizing: border-box;
            border: 1px solid #2a2a2a;
        }
        .login-box h2 { 
            text-align: center; 
            color: #bb86fc; 
            margin-bottom: 25px; 
            font-size: 1.8rem;
        }
        .login-input { 
            width: 100%; 
            padding: 12px; 
            margin: 8px 0 16px 0; 
            border: 1px solid #383838; 
            border-radius: 6px; 
            box-sizing: border-box; 
            background: #2c2c2c; 
            color: white; 
            font-size: 1rem; 
            outline: none;
        }
        .login-input:focus { border-color: #bb86fc; }
        .login-btn { 
            width: 100%; 
            padding: 12px; 
            background-color: #bb86fc; 
            border: none; 
            color: #121212; 
            font-weight: bold; 
            border-radius: 6px; 
            cursor: pointer; 
            font-size: 1rem; 
            margin-top: 10px; 
            transition: background-color 0.2s;
        }
        .login-btn:hover { background-color: #a362f8; }
        .alert-box { 
            background-color: #b71c1c; 
            color: white; 
            padding: 12px; 
            border-radius: 6px; 
            font-size: 0.9rem; 
            margin-bottom: 20px; 
            text-align: center; 
        }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>Daftar Akun Baru</h2>

        <% if(pesan === 'username_kembar') { %>
            <div class="alert-box">⚠️ Username sudah terdaftar! Pilih username lain.</div>
        <% } else if(pesan === 'password_tidak_sama') { %>
            <div class="alert-box">⚠️ Konfirmasi password tidak cocok!</div>
        <% } else if(pesan === 'data_kosong') { %>
            <div class="alert-box">⚠️ Mohon isi semua field yang diperlukan.</div>
        <% } %>

        <form action="/register" method="POST">
            <label style="font-size: 0.85rem; color: #aaa;">Username</label>
            <input type="text" name="username" class="login-input" placeholder="contoh: otaku99" required autocomplete="username">

            <label style="font-size: 0.85rem; color: #aaa;">Nama Panggilan / Display Name</label>
            <input type="text" name="nama_panggilan" class="login-input" placeholder="contoh: Alex" required>

            <label style="font-size: 0.85rem; color: #aaa;">Password</label>
            <input type="password" name="password" class="login-input" placeholder="Minimal 6 karakter" required autocomplete="new-password">

            <label style="font-size: 0.85rem; color: #aaa;">Ulangi Password</label>
            <input type="password" name="konfirmasi_password" class="login-input" placeholder="Ulangi password" required autocomplete="new-password">

            <button type="submit" class="login-btn">Daftar Akun</button>
        </form>

        <div style="text-align: center; margin-top: 20px; font-size: 0.9rem; color: #bbb;">
            <p>Sudah punya akun? <a href="/login" style="color: #bb86fc; font-weight: bold; text-decoration: none;">Masuk di sini</a></p>
        </div>
    </div>

</body>
</html>
